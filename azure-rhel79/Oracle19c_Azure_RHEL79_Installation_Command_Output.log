[oracle@caoradb01 grid]$ chmod 755 -R /u01/app/19.3.0/grid/OPatch
[oracle@caoradb01 grid]$ chown oracle:oinstall -R /u01/app/19.3.0/grid/OPatch
[oracle@caoradb01 grid]$ /u01/app/19.3.0/grid/OPatch/opatch version
