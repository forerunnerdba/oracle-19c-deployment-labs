20. Creating few other ASM Disks, Disk Groups
(a). Check if ASM is running to continue with database installation.
ps -ef | grep pmon

(b). Create partitions for different ASM Disks as 'root' user

[root@caoradb01 rpm]# parted /dev/nvme0n3 --script -a optimal mklabel gpt mkpart primary 0% 100%
[root@caoradb01 rpm]#
[root@caoradb01 rpm]# parted /dev/nvme0n4 --script -a optimal mklabel gpt mkpart primary 0% 100%
[root@caoradb01 rpm]#
[root@caoradb01 rpm]# parted /dev/nvme0n5 --script -a optimal mklabel gpt mkpart primary 0% 100%

