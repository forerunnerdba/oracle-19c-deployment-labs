**********************************************************************************************************************************************************************
                                                Steps for Silent Installation of 19c on OEL8.10 + Non Grid ASM
**********************************************************************************************************************************************************************

1. Create OS groups using the command below. Enter these commands as the 'root' user:

[opc@caoraobs ~]$ sudo -i
[root@caoraobs ~]# /usr/sbin/groupadd -g 501 oinstall
[root@caoraobs ~]# /usr/sbin/groupadd -g 502 dba

(a) Create the users that will own the Oracle software using the commands:

[root@caoraobs ~]# mkdir  /u01
[root@caoraobs ~]# /usr/sbin/useradd -u 501 -g oinstall -G dba oracle
[root@caoraobs ~]# chown -R oracle:oinstall /u01

(b) Create the Oracle Inventory Directory as 'oracle' user

[oracle@caoraobs .ssh]$ mkdir -p /u01/oracle/oraInventory
[oracle@caoraobs .ssh]$ chown -R oracle:oinstall /u01/oracle/oraInventory
[oracle@caoraobs .ssh]$ chmod -R 775 /u01/oracle/oraInventory

(c) Creating the Oracle 19c Installation Directories and Home Directory as 'oracle' user

[oracle@caoraobs .ssh]$ mkdir -p /u01/app/19.3.0/db
[oracle@caoraobs .ssh]$ chown -R oracle:oinstall /u01/app/19.3.0/db
[oracle@caoraobs .ssh]$ chown -R oracle:oinstall /u01/app

(d) Creating Oracle Software directory

[oracle@caoraobs .ssh]$ mkdir -p /u01/app/oracle/software
[oracle@caoraobs .ssh]$ chown -R oracle:oinstall /u01/app/oracle/software

2. Expanding the existing partitions and creating required swap area as per oracle recommendation.

[root@caoraobs oracleoci]# lsblk
NAME               MAJ:MIN RM   SIZE RO TYPE MOUNTPOINT
sda                  8:0    0   150G  0 disk
├─sda1               8:1    0   100M  0 part /boot/efi
├─sda2               8:2    0     1G  0 part /boot
└─sda3               8:3    0 128.9G  0 part
  ├─ocivolume-root 252:0    0 118.9G  0 lvm  /
  └─ocivolume-oled 252:1    0    10G  0 lvm  /var/oled
  

[root@caoraobs oracleoci]# growpart /dev/sda 3
CHANGED: partition=3 start=2304000 old: size=270325727 end=272629726 new: size=312268767 end=314572766
[root@caoraobs oracleoci]# lsblk
NAME               MAJ:MIN RM   SIZE RO TYPE MOUNTPOINT
sda                  8:0    0   150G  0 disk
├─sda1               8:1    0   100M  0 part /boot/efi
├─sda2               8:2    0     1G  0 part /boot
└─sda3               8:3    0 148.9G  0 part
  ├─ocivolume-root 252:0    0 118.9G  0 lvm  /
  └─ocivolume-oled 252:1    0    10G  0 lvm  /var/oled
  
#Creating Swap space in the existing volume group rootvg
[root@caoraobs oracleoci]# lvcreate -L 16G -n lv_swap ocivolume
  Logical volume "lv_swap" created.
  
#Turn off the existing swap area
[root@caoraobs oracleoci]# swapoff -v /.swapfile
swapoff /.swapfile

#Make swap area
[root@caoraobs oracleoci]# mkswap /dev/ocivolume/lv_swap
Setting up swapspace version 1, size = 16 GiB (17179865088 bytes)
no label, UUID=76c1daea-58a5-4b31-bb52-3e56b936379b

#Add new swap area details to fstab and also disable old swap entries in fstab
[root@caoraobs oracleoci]# vi /etc/fstab

#Activate the new swap area
[root@caoraobs oracleoci]# swapon -va
swapon: /dev/mapper/ocivolume-lv_swap: found signature [pagesize=4096, signature=swap]
swapon: /dev/mapper/ocivolume-lv_swap: pagesize=4096, swapsize=17179869184, devsize=17179869184
swapon /dev/mapper/ocivolume-lv_swap

#Check the swap area
[root@caoraobs oracleoci]# swapon -s
Filename                                Type            Size    Used    Priority
/dev/dm-2                               partition       16777212        0       -2

[root@caoraobs oracleoci]# free -m
              total        used        free      shared  buff/cache   available
Mem:          15697        1168         568          16       13960       14173
Swap:         16383           0       16383


3. Modify Configuration, Disable services required for installation.
#Setup the SELINUX to permissive
    set SELINUX to permissive
    vi /etc/selinux/config
	
#Disable few required services
[root@caoraobs ~]# systemctl stop firewalld.service
[root@caoraobs ~]# systemctl disable firewalld.service
Removed /etc/systemd/system/multi-user.target.wants/firewalld.service.
Removed /etc/systemd/system/dbus-org.fedoraproject.FirewallD1.service.

4. Setting up Environmental Variables
[oracle@pnapdploradb01 ~]$ cat .bash_profile
# .bash_profile

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
        . ~/.bashrc
fi

#Oracle Settings
TMP=/tmp; export TMP
TMPDIR=$TMP; export TMPDIR

ORACLE_BASE=/u01/app/oracle; export ORACLE_BASE
DB_HOME=/u01/app/19.3.0/db; export DB_HOME
ORACLE_HOME=$DB_HOME; export ORACLE_HOME
ORACLE_SID=CAOBS; export ORACLE_SID
ORACLE_TERM=xterm; export ORACLE_TERM
BASE_PATH=/usr/sbin:$PATH; export BASE_PATH
PATH=$ORACLE_HOME/bin:$BASE_PATH; export PATH


LD_LIBRARY_PATH=$ORACLE_HOME/lib:/lib:/usr/lib; export LD_LIBRARY_PATH
CLASSPATH=$ORACLE_HOME/JRE:$ORACLE_HOME/jlib:$ORACLE_HOME/rdbms/jlib; export CLASSPATH

5. Install required RPMs for Oracle Installation as 'root' user

cd /u01/app/oracle/software/

[root@caoraobs ~]# dnf install -y oracle-database-preinstall-19c
