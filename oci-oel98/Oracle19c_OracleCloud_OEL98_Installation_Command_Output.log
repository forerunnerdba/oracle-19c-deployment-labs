**********************************************************************************************************************************************************************
                                                Steps for Silent Installation of 19c on OEL9.8 with ASM
**********************************************************************************************************************************************************************

1. Create OS groups using the command below. Enter these commands as the 'root' user:

[opc@caoradboel9 ~]$ sudo -i
[root@caoradboel9 ~]# /usr/sbin/groupadd -g 501 oinstall
[root@caoradboel9 ~]# /usr/sbin/groupadd -g 502 dba
[root@caoradboel9 ~]# /usr/sbin/groupadd -g 503 asmdba
[root@caoradboel9 ~]# /usr/sbin/groupadd -g 504 asmoper
[root@caoradboel9 ~]# /usr/sbin/groupadd -g 506 asmadmin

(a) Create the users that will own the Oracle software using the commands:

[root@caoradboel9 ~]# mkdir  /u01
# OEL 9 uses a default UID range beginning at 1000. Using UID 501 generates a warning because it is outside UID_MIN/UID_MAX.
[root@caoradboel9 ~]# /usr/sbin/useradd -u 501 -g oinstall -G dba oracle
useradd warning: oracle's uid 501 outside of the UID_MIN 1000 and UID_MAX 60000 range.

# Use a UID within the OEL 9 default range.
[root@caoradboel9 ~]# /usr/sbin/useradd -u 1001 -g oinstall -G dba oracle
[root@caoradboel9 ~]# chown -R oracle:oinstall /u01
[root@caoradboel9 ~]# usermod  -G asmdba,asmoper,asmadmin,dba,oinstall oracle
[root@caoradboel9 ~]# usermod -aG wheel oracle # This one we need when running cluster verification script with sudo
[root@caoradboel9 ~]# id oracle
uid=1001(oracle) gid=501(oinstall) groups=501(oinstall),10(wheel),502(dba),503(asmdba),504(asmoper),506(asmadmin)
[root@caoradboel9 ~]#
[root@caoradboel9 ~]# passwd oracle
Changing password for user oracle.
New password:
Retype new password:
passwd: all authentication tokens updated successfully.

(b) Create the Oracle Inventory Directory as 'oracle' user

[oracle@caoradboel9 ~]$ mkdir -p /u01/app/oraInventory
[oracle@caoradboel9 ~]$ chown -R oracle:oinstall /u01/app/oraInventory
[oracle@caoradboel9 ~]$ chmod -R 775 /u01/app/oraInventory

(c) Creating the Oracle Grid Infrastructure Base and  Home Directory as 'oracle' user

[oracle@caoradboel9 ~]$ mkdir -p /u01/app/19.3.0/db
[oracle@caoradboel9 ~]$ mkdir -p /u01/app/19.3.0/grid
[oracle@caoradboel9 ~]$ chown -R oracle:oinstall /u01/app/19.3.0/db
[oracle@caoradboel9 ~]$ chown -R oracle:oinstall /u01/app/
[oracle@caoradboel9 ~]$ chmod -R 775 /u01/app/19.3.0/grid
[oracle@caoradboel9 ~]$
[oracle@caoradboel9 ~]$ mkdir -p /u01/app/oracle/software
[oracle@caoradboel9 ~]$ chown -R oracle:oinstall /u01/app/oracle/software

2. Expanding the existing partitions and creating required swap area as per oracle recommendation.

[root@caoradboel9 ~]# growpart /dev/sdb 3
CHANGED: partition=3 start=4401152 old: size=93325312 end=97726463 new: size=247257055 end=251658206
[root@caoradboel9 ~]# lsblk
NAME               MAJ:MIN RM   SIZE RO TYPE MOUNTPOINTS
sda                  8:0    0    50G  0 disk
sdb                  8:16   0   120G  0 disk
├─sdb1               8:17   0   100M  0 part /boot/efi
├─sdb2               8:18   0     2G  0 part /boot
└─sdb3               8:19   0 117.9G  0 part
  ├─ocivolume-root 252:0    0  29.5G  0 lvm  /
  └─ocivolume-oled 252:1    0    15G  0 lvm  /var/oled
sdc                  8:32   0    50G  0 disk
sdd                  8:48   0    50G  0 disk
sde                  8:64   0    50G  0 disk

#Creating Swap space in the existing volume group rootvg
[root@caoradboel9 ~]# lvcreate -L 16G -n lv_swap ocivolume
  Logical volume "lv_swap" created.
  
#Check the existing swap space
[root@caoradboel9 ~]# swapon -s
Filename                                Type            Size    Used    Priority
/.swapfile                              file            6291452 0       -2

#Turn off the existing swap area
[root@caoradboel9 ~]# swapoff -v /.swapfile
swapoff /.swapfile

#Make swap area
[root@caoradboel9 ~]# mkswap /dev/ocivolume/lv_swap
Setting up swapspace version 1, size = 16 GiB (17179865088 bytes)
no label, UUID=f4df40de-6e60-4cbf-bbad-44e13a29f77b

#Add new swap area details to fstab and also disable old swap entries in fstab
[root@caoradboel9 ~]# vi /etc/fstab
/dev/ocivolume/lv_swap  swap swap defaults 0 0

#Activate the new swap area
[root@caoradboel9 ~]# swapon -va
swapon: /dev/mapper/ocivolume-lv_swap: found signature [pagesize=4096, signature=swap]
swapon: /dev/mapper/ocivolume-lv_swap: pagesize=4096, swapsize=17179869184, devsize=17179869184
swapon /dev/mapper/ocivolume-lv_swap

#Check the swap area
[root@caoradboel9 ~]# swapon -s
Filename                                Type            Size    Used    Priority
/dev/dm-2   
                            partition       16777212        0       -2

[root@caoradboel9 ~]# free -m
               total        used        free      shared  buff/cache   available
Mem:           31631        1153       29582           8        1365       30478
Swap:          16383           0       16383

#Extending the lvm to use 100% Free space in that particular partition
[root@caoradboel9 ~]# lvextend -l +100%FREE /dev/ocivolume/root
  Size of logical volume ocivolume/root changed from 29.50 GiB (7552 extents) to <86.90 GiB (22246 extents).
  Logical volume ocivolume/root successfully resized.

#Even expanding the root lvm it won't take into affect in df -h even though it will show in lsblk. We need to run xfs_growfs or reboot the server 
[root@caoradboel9 ~]# df -h
Filesystem                  Size  Used Avail Use% Mounted on
devtmpfs                    4.0M     0  4.0M   0% /dev
tmpfs                        16G     0   16G   0% /dev/shm
tmpfs                       6.2G  8.8M  6.2G   1% /run
efivarfs                    256K  8.3K  243K   4% /sys/firmware/efi/efivars
/dev/mapper/ocivolume-root   30G   12G   18G  41% /
/dev/sdb2                   2.0G  453M  1.5G  23% /boot
/dev/mapper/ocivolume-oled   15G  191M   15G   2% /var/oled
/dev/sdb1                   100M  7.7M   93M   8% /boot/efi
tmpfs                       3.1G     0  3.1G   0% /run/user/1000
tmpfs                       3.1G     0  3.1G   0% /run/user/988
tmpfs                       3.1G     0  3.1G   0% /run/user/501

[root@caoradboel9 ~]# lsblk
NAME                  MAJ:MIN RM   SIZE RO TYPE MOUNTPOINTS
sda                     8:0    0    50G  0 disk
sdb                     8:16   0   120G  0 disk
├─sdb1                  8:17   0   100M  0 part /boot/efi
├─sdb2                  8:18   0     2G  0 part /boot
└─sdb3                  8:19   0 117.9G  0 part
  ├─ocivolume-root    252:0    0  86.9G  0 lvm  /
  ├─ocivolume-oled    252:1    0    15G  0 lvm  /var/oled
  └─ocivolume-lv_swap 252:2    0    16G  0 lvm  [SWAP]
sdc                     8:32   0    50G  0 disk
sdd                     8:48   0    50G  0 disk
sde                     8:64   0    50G  0 disk

#xfs_growfs would grow the partition without reboot. If we reboot after lvextend we don't need to run this xfs_growfs command.
[root@caoradboel9 ~]# xfs_growfs /
meta-data=/dev/mapper/ocivolume-root isize=512    agcount=4, agsize=1933312 blks
         =                       sectsz=512   attr=2, projid32bit=1
         =                       crc=1        finobt=1, sparse=1, rmapbt=0
         =                       reflink=1    bigtime=1 inobtcount=1 nrext64=0
         =                       exchange=0   metadir=0
data     =                       bsize=4096   blocks=7733248, imaxpct=25
         =                       sunit=0      swidth=0 blks
